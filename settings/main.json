{
  ".source.yaml": {
    "editor": {
      "commentStart": "# ",
      "commentDelimiters": {
        "line": "#"
      },
      "foldEndPattern": "^\\s*$|^\\s*\\}|^\\s*\\]|^\\s*\\)",
      "increaseIndentPattern": "^\\s*.*(:|-) ?(&\\w+)?(\\{[^}\"']*|\\([^)\"']*)?$",
      "decreaseIndentPattern": "^\\s+\\}$",
      "autoIndentOnPaste": false,
      "tabType": "soft"
    }
  }
}
