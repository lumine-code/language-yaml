{
  "name": "YAML",
  "scopeName": "source.yaml",
  "type": "tree-sitter",
  "parser": "tree-sitter-yaml",
  "injectionNames": ["yaml", "yml"],
  "treeSitter": {
    // Head of upstream PR #35: widens external-scanner row state so documents
    // beyond 32,768 lines do not overflow back into parse errors.
    "parserSource": "github:glowcloud/tree-sitter-yaml#8025f83a294d829769d9a99132105bcd68fbaee6",
    "wasmBuildTool": "tree-sitter-cli#v0.26.13",
    "grammar": "yaml.wasm",
    "highlightsQuery": "yaml-highlights.scm",
    "foldsQuery": "yaml-folds.scm",
    "indentsQuery": "yaml-indents.scm",
    "tagsQuery": "yaml-tags.scm"
  },
  "firstLineRegex": ["^(#cloud-config|---)"],
  "fileTypes": [
    "clang-format",
    "eyaml",
    "eyml",
    "yaml",
    "yamllint",
    "yaml.erb",
    "yml",
    "yml.erb",
    "sls",
    "stylelintrc",
    "sublime-syntax",
    "Boxfile",
    "ksy"
  ],
  "comments": {
    "start": "# "
  }
}
